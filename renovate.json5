{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Asia/Tokyo)"
  ],
  "enabledManagers": [
    "pub"
  ],
  "rebaseWhen": "never",
  "lockFileMaintenance": {
    "enabled": true
  },
  "dependencyDashboard": true,
  "baseBranchPatterns": [
    "develop"
  ]
}
